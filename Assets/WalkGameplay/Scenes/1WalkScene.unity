--- !u!114 &232215853
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 232215852}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aa8c7727c414a1f4d9976550d7738ef4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  panel: {fileID: 1447375196}
  text: {fileID: 169909282}
  dialogues:
  - name: "\u043A0"
    phrases:
    - "\u0412 \u043F\u043E\u0447\u0442\u043E\u0432\u043E\u043C \u044F\u0449\u0438\u043A\u0435
      \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0446\u0432\u0435\u0442\u0430\u0441\u0442\u043E\u0435
      \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435."
    - "\"\u041D\u0430 \u0446\u0438\u0440\u043A\u043E\u0432\u043E\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F \u0430\u0440\u0442\u0438\u0441\u0442\u044B,
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C \u041C\u0430\u044D\u0441\u0442\u0440\u043E\"."
    - "\u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u0437\u044F\u0442\u044C
      \u044D\u0442\u043E."
    - "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 enter, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u0432\u043B\u0430\u0434\u0435\u0442\u044C.\r\n"
    - "\u0412\u044B \u0432\u0437\u044F\u043B\u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435."
    phraseColors: []
    uses: 1
    nextScene: 
  - name: 4
    phrases:
    - "\u0417\u0430\u0447\u0435\u043C \u0432\u044B \u0432\u0437\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0441\u044E\u0434\u0430?"
    phraseColors: []
    uses: 1
    nextScene: 
  - name: "\u043A1"
    phrases:
    - "\u0412\u044B \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0432 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439-\u043F\u0440\u0435\u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439
      \u0442\u043E\u043D\u043D\u0435\u043B\u044C."
    phraseColors: []
    uses: 999
    nextScene: 3Scene
  - name: t6
    phrases:
    - "\u042D\u043A\u0430 \u043F\u043E\u043F\u0430\u043B \u0442\u044B, \u043F\u0430\u0446\u0430\u043D\u0447\u0438\u043A!"
    - "\u0427\u0442\u043E \u0442\u0435\u0431\u0435 \u043E\u0442 \u043C\u0435\u043D\u044F
      \u043D\u0430\u0434\u043E?"
    - "\u0412\u0441\u0451, \u0447\u0442\u043E \u0432 \u0442\u0432\u043E\u0438\u0445
      \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u0445, \u044F\u0441\u0435\u043D
      \u043A\u043B\u044E\u0432!"
    - "\u0412 \u043C\u043E\u0438\u0445 \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u0445
      \u043F\u0443\u0441\u0442\u043E."
    - "\u0412\u043E\u0442 \u043B\u043E\u043F\u0443\u0445."
    - ...
    - "\u0422\u044B \u043C\u0435\u043D\u044F \u0440\u0430\u0437\u043E\u0437\u043B\u0438\u043B."
    - "\u0421\u0435\u0439\u0447\u0430\u0441 \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C..."
    - "\u0412\u0417\u0411\u0423\u0427\u041A\u0423"
    phraseColors:
    - {r: 1, g: 1, b: 0, a: 1}
    - {r: 1, g: 0.42352942, b: 0, a: 1}
    - {r: 1, g: 1, b: 0, a: 1}
    - {r: 1, g: 0.42352945, b: 0, a: 1}
    - {r: 1, g: 1, b: 0, a: 1}
    - {r: 1, g: 1, b: 0, a: 1}
    - {r: 1, g: 1, b: 0, a: 1}
    - {r: 1, g: 1, b: 0, a: 1}
    - {r: 1, g: 1, b: 0, a: 1}
    uses: 1
    nextScene: 
  white: {r: 1, g: 1, b: 1, a: 1}
  red: {r: 1, g: 0, b: 0, a: 1}
  green: {r: 0, g: 1, b: 0, a: 1}
  blue: {r: 0, g: 0, b: 1, a: 1}
  yellow: {r: 1, g: 1, b: 0, a: 1}
